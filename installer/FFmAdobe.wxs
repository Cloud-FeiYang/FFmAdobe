<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
    Name="FFmAdobe"
    Version="1.0.0"
    Manufacturer="FFmAdobe Project"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
    Language="2052"
    Codepage="936"
    InstallerVersion="500"
    Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- UI: WixUI_FeatureTree allows feature selection + custom install dirs -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- ===== Custom install directories ===== -->

    <!-- Plugin default: Adobe Premiere Pro plug-ins folder -->
    <StandardDirectory Id="CommonAppDataFolder">
      <!-- not used, just anchor -->
    </StandardDirectory>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="AdobeDir" Name="Adobe">
        <Directory Id="AdobeCommonDir" Name="Common">
          <Directory Id="AdobePluginsDir" Name="Plug-ins">
            <Directory Id="AdobePlugins70Dir" Name="7.0">
              <Directory Id="AdobeMediaCoreDir" Name="MediaCore">
                <Directory Id="PLUGINDIR" Name="FFmAdobe" />
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
      <!-- FFmpegFreeUI gets its own install directory -->
      <Directory Id="FFUIDIR" Name="FFmpegFreeUI" />
    </StandardDirectory>

    <!-- ===== Features ===== -->

    <Feature
      Id="FeaturePlugin"
      Title="FFmpegExporter Plugin for Premiere Pro"
      Description="Installs the FFmpegExporter.prm plugin into Adobe Premiere Pro's plug-in directory. You can change the install path below."
      Level="1"
      ConfigurableDirectory="PLUGINDIR"
      AllowAbsent="no">

      <ComponentGroupRef Id="PluginComponents" />
    </Feature>

    <Feature
      Id="FeatureFFmpegFreeUI"
      Title="FFmpegFreeUI"
      Description="Installs FFmpegFreeUI, the encoding configuration tool used by the Premiere plugin. You can change the install path below."
      Level="1"
      ConfigurableDirectory="FFUIDIR">

      <ComponentGroupRef Id="FFmpegFreeUIComponents" />
      <ComponentRef Id="RegistryComponent" />
    </Feature>

    <!-- ===== Plugin components ===== -->
    <ComponentGroup Id="PluginComponents" Directory="PLUGINDIR">
      <Component Id="FFmpegExporterPrm" Guid="B1C2D3E4-F5A6-7890-BCDE-F12345678901">
        <File Id="FFmpegExporterPrmFile"
              Source="staging\Plugin\FFmpegExporter.prm"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ===== FFmpegFreeUI components ===== -->
    <ComponentGroup Id="FFmpegFreeUIComponents" Directory="FFUIDIR">
      <Component Id="FFmpegFreeUIExe" Guid="C2D3E4F5-A6B7-8901-CDEF-123456789012">
        <File Id="FFmpegFreeUIExeFile"
              Source="staging\FFmpegFreeUI\FFmpegFreeUI.exe"
              KeyPath="yes" />
      </Component>
      <Component Id="D3DCompilerDll" Guid="D3E4F5A6-B7C8-9012-DEF0-234567890123">
        <File Id="D3DCompilerFile"
              Source="staging\FFmpegFreeUI\D3DCompiler_47_cor3.dll"
              KeyPath="yes" />
      </Component>
      <Component Id="WpfGfxDll" Guid="E4F5A6B7-C8D9-0123-EF01-345678901234">
        <File Id="WpfGfxFile"
              Source="staging\FFmpegFreeUI\wpfgfx_cor3.dll"
              KeyPath="yes" />
      </Component>
      <Component Id="PresentationNativeDll" Guid="F5A6B7C8-D9E0-1234-F012-456789012345">
        <File Id="PresentationNativeFile"
              Source="staging\FFmpegFreeUI\PresentationNative_cor3.dll"
              KeyPath="yes" />
      </Component>
      <Component Id="VcRuntime140Dll" Guid="A6B7C8D9-E0F1-2345-0123-567890123456">
        <File Id="VcRuntime140File"
              Source="staging\FFmpegFreeUI\vcruntime140_cor3.dll"
              KeyPath="yes" />
      </Component>
      <Component Id="MonoPosixHelperDll" Guid="B7C8D9E0-F1A2-3456-1234-678901234567">
        <File Id="MonoPosixHelperFile"
              Source="staging\FFmpegFreeUI\MonoPosixHelper.dll"
              KeyPath="yes" />
      </Component>
      <Component Id="LibMonoPosixHelperDll" Guid="C8D9E0F1-A2B3-4567-2345-789012345678">
        <File Id="LibMonoPosixHelperFile"
              Source="staging\FFmpegFreeUI\libMonoPosixHelper.dll"
              KeyPath="yes" />
      </Component>
      <Component Id="PenImcDll" Guid="D9E0F1A2-B3C4-5678-3456-890123456789">
        <File Id="PenImcFile"
              Source="staging\FFmpegFreeUI\PenImc_cor3.dll"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ===== Registry: write FFmpegFreeUI path for the plugin to find ===== -->
    <Component Id="RegistryComponent" Directory="PLUGINDIR" Guid="E0F1A2B3-C4D5-6789-4567-901234567890">
      <!-- Write FFUIDIR\FFmpegFreeUI.exe into HKLM\SOFTWARE\FFmAdobe\FFmpegFreeUIPath -->
      <RegistryValue
        Root="HKLM"
        Key="SOFTWARE\FFmAdobe"
        Name="FFmpegFreeUIPath"
        Value="[FFUIDIR]FFmpegFreeUI.exe"
        Type="string"
        KeyPath="yes" />
    </Component>

  </Package>
</Wix>
